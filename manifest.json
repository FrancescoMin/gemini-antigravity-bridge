{
  "manifest_version": 3,
  "name": "Gemini & Antigravity Bridge",
  "version": "1.0.1",
  "description": "Seamlessly switch between the Gemini web app and your remote Antigravity session.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://antigravity.google.com/*",
    "https://*.antigravity.google.com/*",
    "https://antigravity.static.usercontent.goog/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://antigravity.google.com/*",
        "https://*.antigravity.google.com/*",
        "https://antigravity.static.usercontent.goog/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "all_frames": true,
      "js": [
        "bridge-config.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "web_accessible_resources": [
    {
      "resources": [
        "antigravity-logo.png",
        "gemini-logo.png"
      ],
      "matches": [
        "https://gemini.google.com/*",
        "https://antigravity.google.com/*",
        "https://*.antigravity.google.com/*",
        "https://antigravity.static.usercontent.goog/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ],
  "icons": {
    "16": "antigravity-logo.png",
    "48": "antigravity-logo.png",
    "128": "antigravity-logo.png"
  }
}
